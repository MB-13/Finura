# Production environment for infra/docker-compose.yml. Copy to infra/.env on the VM (chmod 600).
# Never commit the filled-in file.
ENV=prod
API_DOMAIN=api.example.com            # your free DNS name or domain (Caddy gets the TLS certificate)
GHCR_OWNER=your-github-org
IMAGE_TAG=latest

DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
REDIS_PASSWORD=change-me-long-random
REDIS_URL=redis://:change-me-long-random@redis:6379/0

SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # lets account deletion remove the login too (server only!)

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_KEYS=
STORAGE_SIGNING_KEY=                  # long random string
STORAGE_BACKEND=local

WEB_ORIGIN=https://doctune.pages.dev
PUBLIC_API_URL=https://api.example.com
NOTEBOOK_URL=https://colab.research.google.com/github/your-github-org/doctune/blob/nb-v0.1.0/notebook/doctune_train.ipynb
NOTEBOOK_VERSION=0.1.0

EMBEDDING_BACKEND=e5
EMAIL_BACKEND=resend                  # or console until a domain is verified in Resend
EMAIL_FROM=DocTune <noreply@your-domain>
RESEND_API_KEY=
SENTRY_DSN=
HF_TOKEN_READONLY=
LOG_JSON=true

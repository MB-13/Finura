# Copy to backend/.env  (cp env.example .env). Defaults already match `make up`.
ENV=local

DATABASE_URL=postgresql+asyncpg://doctune:doctune@localhost:55432/doctune
DATABASE_URL_SYNC=postgresql+psycopg://doctune:doctune@localhost:55432/doctune
REDIS_URL=redis://localhost:56379/0

# Supabase project (Settings -> API). New projects sign JWTs with asymmetric keys (JWKS);
# set SUPABASE_JWT_SECRET only if your project still uses the legacy HS256 secret.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_JWT_SECRET=

# Local file storage (stand-in for Cloudflare R2). Use a long random value outside local dev.
STORAGE_BACKEND=local
STORAGE_SIGNING_KEY=change-me-to-a-long-random-string

WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# SENTRY_DSN=
LOG_LEVEL=INFO
